user www-data;
worker_processes auto;
pid /run/nginx.pid;

include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

stream {

    upstream snmp_backend {
        server 10.0.1.11:161;
        server 10.0.1.12:161;
        server 10.0.1.13:161;
    }

    server {
        listen 1611 udp;
        proxy_pass snmp_backend;

        proxy_timeout 5s;
        proxy_responses 1;
    }
}
