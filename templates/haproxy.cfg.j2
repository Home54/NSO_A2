global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull

    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend flask_servers

backend flask_servers
    balance roundrobin
    option httpchk GET /

    server devA 10.0.1.11:80 check
    server devB 10.0.1.12:80 check
    server devC 10.0.1.13:80 check

listen stats
    bind *:8011
    mode http

    stats enable
    stats uri /stats
    stats refresh 1s
    stats auth admin:{{ haproxy_ui_password }}
